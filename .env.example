# Copy this file to .env and fill in your values before running docker-compose.

# ── MySQL ──────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=rootpassword
DB_HOST=mysql
DB_PORT=3306
DB_USER=paging_user
DB_PASSWORD=paging_pass
DB_NAME=paging_db

# ── JWT ────────────────────────────────────────────────────────
# IMPORTANT: change this to a long random string in production!
JWT_SECRET=changeme_super_secret_jwt_key_please_change_in_production

# ── Service URLs ───────────────────────────────────────────────
# URL the browser uses to reach the frontend (used for CORS on the server)
CLIENT_URL=http://localhost
